<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="hud" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: #f4f1ea; -unity-font-style: bold;" picking-mode="Ignore">
    <ui:VisualElement name="damage-flash" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(230,10,8); opacity: 0;" picking-mode="Ignore" />
    <ui:VisualElement name="world-bars" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;" picking-mode="Ignore" />
    <ui:VisualElement name="v6-hud" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; transform-origin: 0% 0%;" picking-mode="Ignore">
      <ui:VisualElement name="health-panel" style="position: absolute; width: 460px; height: 72px; margin: 0; padding: 0;background-color: #3a4147; border-width: 4px; border-color: #1f2124; border-radius: 18px; left: 24px; top: 20px;" picking-mode="Ignore">
        <ui:Label style="position: absolute; left: 20px; top: 0px; width: 68px; height: 64px; margin: 0; padding: 0;font-size: 26px; color: #f4f1ea; -unity-text-align: middle-left;" text="차체" picking-mode="Ignore" />
        <ui:VisualElement name="health-bar" style="position: absolute; left: 88px; top: 20px; width: 220px; height: 30px; margin: 0; padding: 0;background-color: #1f2124; border-width: 2px; border-color: #1f2124; border-radius: 16px;" picking-mode="Ignore">
          <ui:VisualElement name="health-trail" style="position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: white;" picking-mode="Ignore" />
          <ui:VisualElement name="health-fill" style="position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: #2f9b94;" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="health-label" style="position: absolute; left: 316px; top: 0px; width: 124px; height: 64px; margin: 0; padding: 0;font-size: 24px; color: #f4f1ea; -unity-text-align: middle-right;" text="100/100" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:VisualElement name="clock-panel" style="position: absolute; width: 240px; height: 88px; margin: 0; padding: 0;background-color: #3a4147; border-width: 4px; border-color: #1f2124; border-radius: 18px; left: 50%; margin-left: -120px; top: 16px;" picking-mode="Ignore">
        <ui:Label name="timer" style="position: absolute; left: 0px; top: 0px; width: 232px; height: 58px; margin: 0; padding: 0;font-size: 46px; color: #f4f1ea; -unity-text-align: middle-center;" text="00:00" picking-mode="Ignore" />
        <ui:Label name="next-event" style="position: absolute; left: 4px; top: 54px; width: 224px; height: 24px; margin: 0; padding: 0;font-size: 18px; color: #c9ced3; -unity-text-align: middle-center;" text="칸 열림 · 90초 후" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:VisualElement name="scrap-panel" style="position: absolute; width: 220px; height: 72px; margin: 0; padding: 0;background-color: #3a4147; border-width: 4px; border-color: #1f2124; border-radius: 18px; right: 104px; top: 20px;" picking-mode="Ignore">
        <ui:Label style="position: absolute; left: 20px; top: 0px; width: 56px; height: 64px; margin: 0; padding: 0;font-size: 44px; color: #f2c230; -unity-text-align: middle-left;" text="⚙" picking-mode="Ignore" />
        <ui:Label name="scrap" style="position: absolute; left: 76px; top: 0px; width: 128px; height: 64px; margin: 0; padding: 0;font-size: 36px; color: #f2c230; -unity-text-align: middle-left;" text="0" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:Button name="hud-pause" style="position: absolute; width: 64px; height: 64px; margin: 0; padding: 0;background-color: #59616a; border-width: 4px; border-color: #1f2124; border-radius: 14px;font-size: 38px; color: #f4f1ea; -unity-text-align: middle-center; right: 24px; top: 24px;" text="Ⅱ" picking-mode="Position" tooltip="일시정지 [Esc]" />
      <ui:VisualElement name="minimap" style="position: absolute; width: 260px; height: 260px; margin: 0; padding: 0;background-color: #9b8a6a; border-width: 4px; border-color: #1f2124; border-radius: 18px; right: 24px; top: 108px;" picking-mode="Ignore">
        <ui:Label name="minimap-preview" style="position: absolute; left: 104px; top: 100px; width: 48px; height: 48px; margin: 0; padding: 0;font-size: 32px; color: #f4f1ea; -unity-text-align: middle-center;" text="▲" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:VisualElement name="loadout-panel" style="position: absolute; width: 300px; height: 300px; margin: 0; padding: 0;background-color: #3a4147; border-width: 4px; border-color: #1f2124; border-radius: 18px; left: 24px; bottom: 24px;" picking-mode="Ignore">
        <ui:Label style="position: absolute; left: 16px; top: 8px; width: 260px; height: 36px; margin: 0; padding: 0;font-size: 20px; color: #c9ced3; -unity-text-align: middle-left;" text="내 차 (앞 ↑)" picking-mode="Ignore" />
        <ui:VisualElement style="position: absolute; left: 114px; top: 114px; width: 68px; height: 104px; margin: 0; padding: 0;background-color: #2f9b94; border-width: 4px; border-color: #1f2124; border-radius: 12px;" picking-mode="Ignore" />
        <ui:Label name="hud-slot-0" style="position: absolute; left: 96px; top: 58px; width: 56px; height: 46px; margin: 0; padding: 0;font-size: 16px; color: #f4f1ea; -unity-text-align: middle-center;background-color: #2b3035; border-width: 2px; border-color: #1f2124; border-radius: 6px;" text="+" picking-mode="Ignore">
          <ui:VisualElement name="hud-durability-0" style="position: absolute; left: 2px; top: 36px; width: 48px; height: 4px; margin: 0; padding: 0;background-color: #2f9b94; border-width: 0px; border-color: #1f2124; border-radius: 0px;" picking-mode="Ignore" />
