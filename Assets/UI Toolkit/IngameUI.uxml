    <ui:VisualElement name="swap-card" style="display: none; position: absolute; align-self: center; bottom: 44px; width: 430px; max-width: 94%; padding: 10px;background-color: #2b3035; border-width: 2px; border-color: #1f2124; border-radius: 9px;" picking-mode="Ignore">
